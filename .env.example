# Server-only secrets. NEVER prefix with VITE_ and never commit real keys.

# Option A (recommended, free, no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: first model to try. Falls back automatically if it 404s or is rate-limited.
# GEMINI_MODEL=gemini-2.5-flash

# Option B (free tier, no card, very fast): https://console.groq.com/keys
# Used as an automatic fallback when Gemini is rate-limited (text chat only).
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
